# 기본값: 무료 플랜으로 테스트하기 쉬운 Groq
AI_PROVIDER=groq
PORT=3000
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOKENS=512

# 프론트엔드를 다른 주소에서 실행할 때만 지정하세요.
# 예: CORS_ORIGIN=http://localhost:5500
CORS_ORIGIN=

# 사용할 제공사의 키 하나만 설정하면 됩니다.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


